# Better Auth / MongoDB
BETTER_AUTH_DB_URI=
BETTER_AUTH_SECRET=
# Must be the clean frontend origin, with no trailing comment or path.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (server-only secret)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe hosted Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Canonical frontend origin used for Stripe success/cancel redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployed Express backend origin. In production this must be set explicitly.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
